# Copy to .env (gitignored) and fill in. Never commit .env: it holds your server's address and secrets.
# Comments go on their own line: systemd reads this file too, and it has no trailing comments.

# --- Server -------------------------------------------------------------
# The ssh alias of your server, as in ~/.ssh/config. provision.sh writes it for AWS.
HOST=agentbox
# Filled by provision.sh (AWS). For your own server, its public IP or leave empty.
IP=
# 1: a terminal on your phone (Moshi, Blink): the server gets mosh, provision.sh opens UDP 60000-61000 on AWS.
MOSH=0

# --- AWS (only for provision.sh) ----------------------------------------
REGION=eu-west-2
INSTANCE_TYPE=m7i-flex.xlarge
DISK_GB=100
# none: the server gets no AWS access (default). spawn: agents on it may launch SPAWN_TYPES in REGION.
AWS_ROLE=none
SPAWN_TYPES=t3.small,t3.medium,t3.large

# --- herdr ---------------------------------------------------------------
# Only used when herdr is not installed on this laptop; otherwise the laptop's version is used. Example: 0.9.0
HERDR_VERSION=

# --- Phone notifications (ntfy.sh) -------------------------------------------
# Filled by provision.sh with a random topic. The topic is the only protection on ntfy.sh: keep it secret.
NTFY_TOPIC=

# --- Board: web panel and API (optional) ---------------------------------------
# Only these addresses can sign in (comma-separated).
BOARD_EMAIL=
# Private (default): http://localhost:8787, reached through `ssh -L 8787:127.0.0.1:8787 agentbox`.
# Public: https://femme.example.com with BOARD_PUBLIC=1 and a DNS A record pointing at the server.
BOARD_URL=
# 1: serve the board on the internet over HTTPS (Caddy, ports 80/443), for agents calling the API from elsewhere.
BOARD_PUBLIC=0
# Sign-in links are emailed through Resend. Empty: they are printed in the board's log
# (journalctl --user -u femme-board) instead.
RESEND_API_KEY=
# A sender your Resend domain allows, quoted: "FEMME <hello@example.com>"
MAIL_FROM=

# --- Worker budget --------------------------------------------------------
# Issues worked at once.
PARALLEL=2
# Percent of Claude's 5-hour window at which the worker pauses its agents (and account rotation switches).
CAP=60

# --- Claude account rotation (optional) -------------------------------------
# 1: switch to another stored Claude account (cswap) when the active one passes CAP, or its Fable weekly
# limit passes FABLE_CAP. You are responsible for following your provider's terms when using several accounts.
ACCOUNT_ROTATION=0
FABLE_CAP=96

# --- Updates -----------------------------------------------------------------
# 1: the server deploys itself when main moves on GitHub (every 20 s). Anyone who can merge can then run code on it.
AUTODEPLOY=0

# --- Misc ------------------------------------------------------------------
# Laptop `pc` runs on (its hostname); only needed when several laptops are linked.
PC_HOST=
# Space-separated names of MCP servers from your laptop's ~/.claude.json to copy to the server.
CLAUDE_MCP=
