REGION=eu-west-2
INSTANCE_TYPE=m7i-flex.xlarge
DISK_GB=100
HOST=agentbox
PC_HOST=            # laptop `pc` runs on (its hostname); only needed when several laptops are linked
# Filled by provision.sh. The topic is the only auth on ntfy.sh, keep it secret.
NTFY_TOPIC=
IP=
# Issues board (optional). Only this address can sign in; links are sent with Resend.
BOARD_EMAIL=
BOARD_URL=          # e.g. https://femme.example.com, an A record pointing at IP (DNS only)
RESEND_API_KEY=
MAIL_FROM=          # e.g. "FEMME <hello@example.com>", a sender your Resend domain allows
