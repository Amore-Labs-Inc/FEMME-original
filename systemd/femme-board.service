[Unit]
Description=FEMME issues board (localhost; Caddy serves it over HTTPS)

[Service]
EnvironmentFile=%h/femme/.env
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/femme-board
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
