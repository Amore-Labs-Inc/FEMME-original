# Laptop side: lends this machine's herdr to the board, so its terminals show up and can be used
# there, and its sshd to `pc` on the VPS (pc-setup.sh). The VPS sees them as
# ~/.config/herdr/remote/<hostname>.sock and <hostname>.ssh while the laptop is awake.
[Unit]
Description=Link this machine's herdr to the FEMME board (socket forwarded to the VPS)
After=network-online.target

[Service]
ExecStart=/usr/bin/ssh -N -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R %h/.config/herdr/remote/%l.sock:%h/.config/herdr/herdr.sock -R %h/.config/herdr/remote/%l.ssh:127.0.0.1:22 agentbox
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
